{
    "name": "@diia-inhouse/scaffold",
    "version": "2.60.6",
    "description": "Hygen-based CLI that scaffolds Diia services, packages and code templates",
    "license": "SEE LICENCE IN LICENCE.md",
    "author": "diia-team",
    "repository": "https://github.com/diia-open-source/be-scaffold",
    "bin": {
        "scaffold": "dist/bin.js"
    },
    "files": [
        "dist"
    ],
    "main": "dist/index.js",
    "scripts": {
        "lint": "oxlint && oxfmt --check .",
        "lint-fix": "oxlint --fix && oxfmt .",
        "lint:lockfile": "lockfile-lint --path package-lock.json --allowed-hosts registry.npmjs.org --validate-https",
        "build": "rimraf dist && tsc && npm run cp:templates",
        "clean:result": "rimraf generation-result",
        "cp:templates": "cd src && copyfiles _templates/**/*.t ../dist && copyfiles _sharedTemplates/**/*.t ../dist",
        "prepare": "npm run build",
        "find-circulars": "madge --circular --extensions ts ./",
        "semantic-release": "semantic-release"
    },
    "dependencies": {
        "@diia-inhouse/types": "14.6.0",
        "chalk": "4.1.2",
        "enquirer": "2.4.1",
        "execa": "5.1.1",
        "hygen": "6.2.11",
        "lodash": "4.18.1"
    },
    "devDependencies": {
        "@diia-inhouse/configs": "7.2.2",
        "@diia-inhouse/oxc-config": "4.0.3",
        "@types/lodash": "4.17.24",
        "@types/node": "25.3.3",
        "copyfiles": "2.4.1",
        "lockfile-lint": "4.14.1",
        "madge": "8.0.0",
        "oxfmt": "0.72.0",
        "oxlint": "1.87.0",
        "oxlint-tsgolint": "7.0.2003",
        "rimraf": "6.1.3",
        "semantic-release": "24.2.3",
        "typescript": "5.9.3"
    },
    "commitlint": {
        "extends": "@diia-inhouse/configs/dist/commitlint"
    },
    "release": {
        "extends": "@diia-inhouse/configs/dist/semantic-release/package",
        "branches": [
            "main"
        ]
    },
    "engines": {
        "node": ">=24"
    },
    "madge": {
        "tsConfig": "./tsconfig.json"
    }
}
